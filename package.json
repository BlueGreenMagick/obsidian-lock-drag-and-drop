{
  "name": "obsidian-lock-drag-and-drop",
  "version": "1.0.4",
  "description": "Prevent accidental drag and drop in Obsidian sidebar views.",
  "keywords": [],
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "jiti esbuild.config.mts",
    "build": "tsc -noEmit -skipLibCheck && jiti esbuild.config.mts production",
    "version": "node version-bump.mjs && pnpm fmt && git add manifest.json versions.json",
    "lint": "eslint . && pnpm fmt:check",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "oxfmt": "^0.63.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1"
  },
  "packageManager": "pnpm@11.22.0"
}
